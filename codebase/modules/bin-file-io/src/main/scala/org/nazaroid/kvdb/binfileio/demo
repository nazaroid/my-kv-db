import cats.effect.*
import fs2.{Stream, Pull, Chunk}
import fs2.io.file.{Files, Path}
import scodec.bits.ByteVector
import java.nio.charset.StandardCharsets

// 1. Определение типов данных
enum FieldType {
  case Int32
  case Int64
  case StringUtf8(sizeFromField: String)
}

case class FieldDef(name: String, fType: FieldType)
type Row = Map[String, Any]

// 2. Основная функция
def readGenericFile(filePath: String, schema: List[FieldDef]): IO[List[Row]] = {

  // Рекурсивный разбор потока байтов
  def decodeStream(s: Stream[IO, Byte]): Pull[IO, Row, Unit] = {

    // Внутренняя функция для последовательного чтения полей одной записи
    def readFields(currentStream: Stream[IO, Byte],
                   remainingSchema: List[FieldDef],
                   acc: Row): Pull[IO, Row, Unit] = {
      remainingSchema match {
        case Nil =>
          // Запись полностью прочитана, выдаем её и рекурсивно парсим следующую
          Pull.output1(acc) >> decodeStream(currentStream)

        case FieldDef(name, fType) :: tail =>
          val bytesToRead = fType match {
            case FieldType.Int32 => Some(4)
            case FieldType.Int64 => Some(8)
            case FieldType.StringUtf8(ref) => acc.get(ref).map(_.toString.toInt)
          }

          bytesToRead match {
            case Some(n) =>
              currentStream.pull.unconsN(n).flatMap {
                case Some((chunk, nextStream)) =>
                  val bv = chunk.toByteVector
                  val value = fType match {
                    case FieldType.Int32 => bv.toInt()
                    case FieldType.Int64 => bv.toLong()
                    case FieldType.StringUtf8(_) => new String(bv.toArray, StandardCharsets.UTF_8)
                  }
                  readFields(nextStream, tail, acc + (name -> value))
                case None => Pull.done // Неожиданный конец файла внутри записи
              }
            case None =>
              Pull.raiseError[IO](new Exception(s"Не найдено поле размера для $name"))
          }
      }
    }

    // Проверяем, есть ли в стриме хотя бы 1 байт, прежде чем начинать чтение полей
    s.pull.peek1.flatMap {
      case Some(_) => readFields(s, schema, Map.empty)
      case None    => Pull.done // Естественный конец файла
    }
  }

  Files[IO].readAll(Path(filePath))
    .through(s => decodeStream(s).stream)
    .compile
    .toList
}


