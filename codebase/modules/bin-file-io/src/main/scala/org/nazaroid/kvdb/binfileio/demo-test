package org.binfileio

import munit.CatsEffectSuite
import java.nio.file.Files

class BinFileIOTest extends CatsEffectSuite {

  // Создаем временный файл для теста
  val tempFile = FunFixture[java.nio.file.Path](
    setup = { _ => Files.createTempFile("segment-index", ".bin") },
    teardown = { path => Files.deleteIfExists(path) }
  )

  val segmentIndexSchema = List(
    FieldDef("keySize", FieldType.Int32),
    FieldDef("key", FieldType.StringUtf8(sizeFromField = "keySize")),
    FieldDef("offset", FieldType.Int64)
  )

  tempFile.test("write and read should maintain data integrity (Roundtrip)") { path =>
    val filePath = path.toString

    val rows: List[Row] = List(
      Map("keySize" -> 4, "key" -> "user", "offset" -> 1024L),
      Map("keySize" -> 5, "key" -> "admin", "offset" -> 2048L)
    )

    for {
      // 1. Записываем
      _ <- BinFileIO.write(filePath, segmentIndexSchema, rows)

      // 2. Читаем
      result <- BinFileIO.read(filePath, segmentIndexSchema)

      // 3. Проверяем
    } yield {
      assertEquals(result.size, 2)
      assertEquals(result.head("key"), "user")
      assertEquals(result.last("offset"), 2048L)
    }
  }
}